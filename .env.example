# Local only. Production: TLS, separate read-only web and write/admin roles.
DATABASE_URL=postgres://crypto:local-development-only@localhost:5432/crypto?sslmode=disable
# Go jobs and migrations use a DIRECT connection, not a transaction pooler.
DATABASE_DIRECT_URL=postgres://crypto:local-development-only@localhost:5432/crypto?sslmode=disable
COINGECKO_API_KEY=
COINGECKO_API_URL=https://api.coingecko.com/api/v3
