# Go only. Use a separate development Neon database; quote values before sourcing.
# Admin role for schema/recovery; restricted ingest role for normal ingestion.
DATABASE_DIRECT_URL='postgresql://ROLE:PASSWORD@DIRECT_HOST/DEV_DB?sslmode=verify-full'
COINGECKO_API_KEY='YOUR_DEMO_KEY'
COINGECKO_API_URL='https://api.coingecko.com/api/v3'
# Optional local alternative:
# DATABASE_DIRECT_URL='postgresql://YOUR_MAC_USER@localhost/crypto_dev?sslmode=disable'
# Next.js DATABASE_URL belongs in web/.env.local, not this file.
